# Display available commands
[private]
default:
    @just --list

app_name := "Heartbeat"
bundle_id := "dev.sglavoie.Heartbeat"
version := `sed -n 's/.*static let version = "\(.*\)".*/\1/p' Sources/HeartbeatCore/HeartbeatCore.swift`
bundle_dir := ".build/bundle"
app_path := bundle_dir / app_name + ".app"
install_path := home_directory() / "Applications" / app_name + ".app"

# Self-signed identity kept in its own keychain, so the designated requirement
# (and with it the notification and login-item grants) survives rebuilds.
signing_identity := "Heartbeat Local Signing"
signing_keychain := home_directory() / "Library/Keychains/heartbeat-signing.keychain-db"
signing_keychain_password := "heartbeat"

# Build all targets
build:
    swift build

# Run the test suite
test:
    swift test

# Show agent health (e.g. `just status --all`, `just status --json`)
[no-exit-message]
status *args:
    @swift build -q --product heartbeatctl
    @"$(swift build --show-bin-path)/heartbeatctl" status {{args}}

# Explain one agent's verdict rule by rule (full label or the part after the prefix)
[no-exit-message]
explain label *args:
    @swift build -q --product heartbeatctl
    @"$(swift build --show-bin-path)/heartbeatctl" explain {{label}} {{args}}

# Throwaway agents for checking Heartbeat live (verification steps 3, 4 and 11). They are regular plists in
# ~/Library/LaunchAgents (not stowed), with their scripts under ~/Library/Application Support/Heartbeat/canary.
canary_label := "com.sglavoie.heartbeat-canary"
canary_daemon_label := "com.sglavoie.heartbeat-canary-daemon"
canary_dir := home_directory() / "Library/Application Support/Heartbeat/canary"
launch_agents_dir := home_directory() / "Library/LaunchAgents"

# Load a canary that runs every 120 s and exits with the code in its exit-code file (starts at `code`)
canary-install code="1":
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{canary_dir}}"
    plist="{{launch_agents_dir}}/{{canary_label}}.plist"
    mkdir -p "$dir"
    echo "{{code}}" > "$dir/exit-code"
    cat > "$dir/canary.sh" <<'SH'
    #!/bin/sh
    # Exits with the number in exit-code next to this script (0 when missing).
    code=$(cat "$(dirname "$0")/exit-code" 2>/dev/null || echo 0)
    echo "$(date '+%Y-%m-%d %H:%M:%S') heartbeat canary run, exiting $code"
    exit "$code"
    SH
    chmod +x "$dir/canary.sh"
    cat > "$plist" <<PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>Label</key><string>{{canary_label}}</string>
        <key>ProgramArguments</key><array><string>$dir/canary.sh</string></array>
        <key>StartInterval</key><integer>120</integer>
        <key>RunAtLoad</key><true/>
        <key>StandardOutPath</key><string>$dir/canary.log</string>
        <key>StandardErrorPath</key><string>$dir/canary.log</string>
    </dict>
    </plist>
    PLIST
    plutil -lint -s "$plist"
    launchctl bootout "gui/$(id -u)/{{canary_label}}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "Loaded {{canary_label}} (every 120 s, exit {{code}}). Change the exit code with 'just canary-exit 0'."

# Set the exit code the canary's next run returns (then use Run Now in the menu)
canary-exit code:
    @echo "{{code}}" > "{{canary_dir}}/exit-code"
    @echo "The canary's next run exits {{code}}."

# Load a KeepAlive (SuccessfulExit:false) canary that exits 0 right away, so it stays down
canary-daemon-install:
    #!/usr/bin/env bash
    set -euo pipefail
    dir="{{canary_dir}}"
    plist="{{launch_agents_dir}}/{{canary_daemon_label}}.plist"
    mkdir -p "$dir"
    cat > "$dir/daemon.sh" <<'SH'
    #!/bin/sh
    echo "$(date '+%Y-%m-%d %H:%M:%S') heartbeat daemon canary started; exiting 0 so launchd leaves it down"
    exit 0
    SH
    chmod +x "$dir/daemon.sh"
    cat > "$plist" <<PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
        <key>Label</key><string>{{canary_daemon_label}}</string>
        <key>ProgramArguments</key><array><string>$dir/daemon.sh</string></array>
        <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
        <key>RunAtLoad</key><true/>
        <key>StandardOutPath</key><string>$dir/daemon.log</string>
        <key>StandardErrorPath</key><string>$dir/daemon.log</string>
    </dict>
    </plist>
    PLIST
    plutil -lint -s "$plist"
    launchctl bootout "gui/$(id -u)/{{canary_daemon_label}}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "Loaded {{canary_daemon_label}}; Heartbeat should show it amber, then red on the next poll."

# Unload and delete the KeepAlive canary
canary-daemon-uninstall:
    -@launchctl bootout "gui/$(id -u)/{{canary_daemon_label}}" 2>/dev/null
    rm -f "{{launch_agents_dir}}/{{canary_daemon_label}}.plist" "{{canary_dir}}/daemon.sh" "{{canary_dir}}/daemon.log"

# Unload and delete both canaries and their files
canary-uninstall: canary-daemon-uninstall
    -@launchctl bootout "gui/$(id -u)/{{canary_label}}" 2>/dev/null
    rm -f "{{launch_agents_dir}}/{{canary_label}}.plist"
    rm -rf "{{canary_dir}}"

# Remove build artifacts
clean:
    swift package clean
    rm -rf .build

# Build the app icon (AppIcon.icns) from Resources/icon.png
icon:
    #!/usr/bin/env bash
    set -euo pipefail
    iconset="{{bundle_dir}}/AppIcon.iconset"
    rm -rf "$iconset"
    mkdir -p "$iconset"
    for size in 16 32 128 256 512; do
        sips -z $size $size Resources/icon.png --out "$iconset/icon_${size}x${size}.png" >/dev/null
        double=$((size * 2))
        sips -z $double $double Resources/icon.png --out "$iconset/icon_${size}x${size}@2x.png" >/dev/null
    done
    iconutil -c icns -o "{{bundle_dir}}/AppIcon.icns" "$iconset"

# Assemble an unsigned Heartbeat.app in .build/bundle
bundle: icon
    #!/usr/bin/env bash
    set -euo pipefail
    swift build -c release --product {{app_name}}
    bin_path="$(swift build -c release --show-bin-path)"
    build_number="$(git rev-list --count HEAD 2>/dev/null || echo 1)"
    rm -rf "{{app_path}}"
    mkdir -p "{{app_path}}/Contents/MacOS" "{{app_path}}/Contents/Resources"
    cp "$bin_path/{{app_name}}" "{{app_path}}/Contents/MacOS/{{app_name}}"
    cp "{{bundle_dir}}/AppIcon.icns" "{{app_path}}/Contents/Resources/AppIcon.icns"
    sed -e "s/@EXECUTABLE@/{{app_name}}/" \
        -e "s/@BUNDLE_ID@/{{bundle_id}}/" \
        -e "s/@VERSION@/{{version}}/" \
        -e "s/@BUILD@/$build_number/" \
        Resources/Info.plist.in > "{{app_path}}/Contents/Info.plist"
    printf 'APPL????' > "{{app_path}}/Contents/PkgInfo"
    plutil -lint "{{app_path}}/Contents/Info.plist"

# Build and sign Heartbeat.app with the local signing identity
sign: bundle
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ ! -f "{{signing_keychain}}" ]]; then
        echo "error: signing keychain not found; run 'just setup-signing' once first" >&2
        exit 1
    fi
    security unlock-keychain -p "{{signing_keychain_password}}" "{{signing_keychain}}"
    codesign --force --timestamp=none \
        --sign "{{signing_identity}}" \
        --keychain "{{signing_keychain}}" \
        --identifier "{{bundle_id}}" \
        "{{app_path}}"
    codesign --verify --strict --verbose=2 "{{app_path}}"

# Sign, then replace the copy in ~/Applications and launch it
install: sign
    #!/usr/bin/env bash
    set -euo pipefail
    if pkill -x {{app_name}}; then
        while pgrep -x {{app_name}} >/dev/null; do sleep 0.1; done
    fi
    mkdir -p "$(dirname "{{install_path}}")"
    rm -rf "{{install_path}}"
    ditto "{{app_path}}" "{{install_path}}"
    open "{{install_path}}"

# Sign and launch the app straight from .build/bundle
run: sign
    open "{{app_path}}"

# Quit the app and remove it from ~/Applications
uninstall:
    pkill -x {{app_name}} || true
    rm -rf "{{install_path}}"

# Print the designated requirement of the built app
show-dr:
    @codesign -d -r- "{{app_path}}" 2>&1 | sed -n 's/^designated => //p'

# One-off: create the self-signed code-signing identity and trust it
setup-signing:
    #!/usr/bin/env bash
    set -euo pipefail
    keychain="{{signing_keychain}}"
    if [[ -f "$keychain" ]]; then
        echo "Signing keychain already exists at $keychain; leaving it as is."
        echo "Replacing it would change the designated requirement and void the notification and login-item grants."
        exit 0
    fi
    workdir="$(mktemp -d)"
    trap 'rm -rf "$workdir"' EXIT
    cat > "$workdir/cert.cnf" <<'CNF'
    [req]
    distinguished_name = dn
    x509_extensions = ext
    prompt = no
    [dn]
    CN = {{signing_identity}}
    [ext]
    basicConstraints = critical,CA:false
    keyUsage = critical,digitalSignature
    extendedKeyUsage = critical,codeSigning
    CNF
    openssl req -x509 -quiet -newkey rsa:2048 -nodes -days 7300 \
        -keyout "$workdir/key.pem" -out "$workdir/cert.pem" -config "$workdir/cert.cnf"
    # macOS `security` only reads PKCS#12 files that use the legacy algorithms.
    openssl pkcs12 -export -legacy -passout pass:import \
        -inkey "$workdir/key.pem" -in "$workdir/cert.pem" \
        -name "{{signing_identity}}" -out "$workdir/identity.p12"
    security create-keychain -p "{{signing_keychain_password}}" "$keychain"
    # No auto-lock timeout; `just sign` unlocks it after a reboot.
    security set-keychain-settings "$keychain"
    security unlock-keychain -p "{{signing_keychain_password}}" "$keychain"
    security import "$workdir/identity.p12" -k "$keychain" -P import -T /usr/bin/codesign
    security set-key-partition-list -S apple-tool:,apple:,codesign: -s \
        -k "{{signing_keychain_password}}" "$keychain" >/dev/null
    security add-trusted-cert -r trustRoot -p codeSign -k "$keychain" "$workdir/cert.pem"
    security find-identity -p codesigning -v "$keychain"
